++	default:
++		return;
++	}
++
++	regmap_update_bits(port->pcs2, AIROHA_PCS_HSGMII_PCS_CTROL_6,
++			   AIROHA_PCS_HSGMII_PCS_SGMII_SPD_FORCE_10 |
++			   AIROHA_PCS_HSGMII_PCS_SGMII_SPD_FORCE_100 |
++			   AIROHA_PCS_HSGMII_PCS_SGMII_SPD_FORCE_1000 |
