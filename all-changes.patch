++	if (memcmp(foe->src_ip, src, sizeof(src)) ||
++	    memcmp(foe->dest_ip, dst, sizeof(dst)))
++		return false;
++
++	if (!with_ports)
++		return true;
++
++	return skb->has_ports && foe->src_port == skb->src_port &&
++	       foe->dest_port == skb->dst_port;
++}
