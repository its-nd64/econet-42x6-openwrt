++static bool
++airoha_ppe_ipv6_tuple_match(const struct airoha_foe_ipv6 *foe,
++			    const struct airoha_ppe_skb_tuple *skb,
++			    bool with_ports)
++{
++	u32 src[IPV6_ADDR_WORDS], dst[IPV6_ADDR_WORDS];
