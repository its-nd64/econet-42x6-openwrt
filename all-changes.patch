diff --git a/target/linux/airoha/base-files/lib/upgrade/platform.sh b/target/linux/airoha/base-files/lib/upgrade/platform.sh
new file mode 100755
index 0000000000..2db8485b10
--- /dev/null
+++ b/target/linux/airoha/base-files/lib/upgrade/platform.sh
@@ -0,0 +1,164 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Sysupgrade support for the Airoha EN7523 family.
+#
+# Storage model
+# -------------
+# The bootloader loads a FIT image (kernel, optionally + squashfs rootfs) from the
+# "tclinux_slave" partition.  That partition is declared in the board DTS with
+#
+#	compatible = "denx,fit";
+#
+# so the kernel's mtdsplit_fit parser (CONFIG_MTD_SPLIT_FIT_FW) splits it at boot
+# into "kernel", "rootfs" and - via CONFIG_MTD_SPLIT_SQUASHFS_ROOT - "rootfs_data".
+#
+# Consequence for the upgrade: the split child partitions are *derived*, they must
+# never be written directly.  The whole sysupgrade image is written over the parent
+# partition ("tclinux_slave"), exactly like the vendor A/B scheme does for slot B.
+#
+# Verified on hardware (Econet vGP-42X6V1, EN7523, Winbond W25N01K):
+#   mtd erase /dev/mtd3                       -> 1.02 s, partition reads back 0xff
+#   mtd write <7.7 MB payload> /dev/mtd3      -> 2.90 s
+#   read-back + mtd verify                    -> identical, "Success"
+# Note: writing over non-erased NAND pages silently stores (old AND new) and
+# corrupts ECC, so the erase step is mandatory.  "mtd write" erases by default;
+# never use plain "dd" against /dev/mtdN for firmware.
+
+# ---------------------------------------------------------------------------
+# sysupgrade -n  ("do not keep configuration" == clean install)
+#
+# /overlay is a UBIFS volume on its own MTD partition ("data"), so the image
+# write into "tclinux_slave" never touches it: a "clean install" would still
+# boot with the previous configuration.  Worse, /bin/config_generate only runs
+# /bin/board_detect when /etc/board.json is missing
+#	[ -s $CFG ] || /bin/board_detect || exit 1
+# so the stale /etc/board.json also stops the board.d scripts from ever running
+# again -- observed on hardware: a freshly flashed image kept the old
+# conduit-only bridge and ignored the new 02_network.  Do the reset ourselves
+# and let the next boot rebuild the config from board.d.
+#
+# How "-n" is detected, and where the reset runs (both read out of the sources
+# that shipped in the image, procd-2026.09.27~675942be + base-files):
+#
+#   * SAVE_CONFIG is *not* usable here.  It is set in /sbin/sysupgrade's own
+#     shell (line 37 default, line 41 for -n), but it is never exported into
+#     stage 2 nor forwarded in the ubus payload; $R/lib/upgrade/stage2 only
+#     exports IMAGE/COMMAND/INTERACTIVE/VERBOSE/CONFFILES.
+#   * The signal that *does* survive is UPGRADE_BACKUP:
+#       /sbin/sysupgrade:445   json_add_string backup "$CONF_TAR"   # only if SAVE_CONFIG=1
+#       procd sysupgrade.c     if (backup) setenv("UPGRADE_BACKUP", backup, 1);
+#       -> non-empty = keep the config, empty/unset = "-n" = clean install.
+#   * stage 2 runs in the REAL root, not in a scratch chroot: procd chroots to
+#     prefix=/tmp/root before exec'ing /sbin/upgraded, but upgraded.c escapes it
+#     immediately ( open("/") ; chroot(".")  <- cwd is still the real "/" ;
+#     fchdir(fd) ) and only then execs /lib/upgrade/stage2.  So the hook below
+#     sees the live /overlay mounted read-write.
+#   * The reset itself deletes the OLD system's files directly in the overlay
+#     upperdir (/overlay/upper), not through the merged view, so that the
+#     conffiles shipped by the NEW image stay visible (see platform_wipe_config).
+#   * platform_pre_upgrade() is the only hook stage 2 calls before
+#     switch_to_ramfs (lib/upgrade/stage2:165).  It must not be put into
+#     platform_check_image(): that one also runs for "sysupgrade -T", which
+#     validates the image and then exits without upgrading anything.
+# ---------------------------------------------------------------------------
+
+WIPE_LOG=/root/sysupgrade-wipe.log
+
+# Delete what the OLD system created on top of the read-only rootfs, working
+# directly inside the overlay upperdir instead of going through the merged view.
+# The difference matters, and it was measured on the image with unsquashfs:
+#
+#   * the new image ships /etc/config/dhcp, /etc/config/dropbear and
+#     /etc/config/firewall inside the squashfs;
+#   * "rm -rf /etc/config; mkdir /etc/config" through the merged view leaves an
+#     empty upper directory, i.e. it HIDES those three conffiles - dnsmasq,
+#     dropbear and the firewall would then start without their defaults, which
+#     is a good way to lose the network after the reboot;
+#   * removing only the upper copies reproduces a fresh installation exactly,
+#     because a fresh installation is "image + empty overlay": the shipped
+#     conffiles become visible again, while /etc/board.json (which is NOT part of
+#     the image) disappears, so /bin/board_detect regenerates it on the next boot
+#     and /etc/board.d/02_network finally runs.
+#
+# The upper directory is recreated with a plain mkdir (not rmdir+mkdir through
+# the merged view) so overlayfs never marks it opaque, and /etc/dropbear is
+# deliberately left alone: /etc/dropbear/authorized_keys is the way back in if
+# the flashed image does not come up.
+platform_wipe_config() {
+	local ovl=/overlay/upper
+
+	{
+		echo "--- $(date) wipe (sysupgrade -n) ---"
+		echo "mounts:"; /bin/mount
+		echo "/etc/config before:"; ls -la /etc/config 2>&1
+		echo "/etc/board.json before:"; ls -l /etc/board.json 2>&1
+		echo "$ovl/etc before:"; ls -la $ovl/etc 2>&1
+	} >> $WIPE_LOG 2>&1
+
+	if [ -d "$ovl/etc" ]; then
+		rm -rf "$ovl/etc/config" "$ovl/etc/board.json"
+		mkdir -p "$ovl/etc/config"
+		chmod 0755 "$ovl/etc/config"
+		echo "wiped upperdir: $ovl/etc/{config,board.json}" >> $WIPE_LOG
+	else
+		# No overlay upperdir found: fall back to the merged view. Less
+		# exact, but still better than doing nothing.
+		rm -rf /etc/config /etc/board.json
+		mkdir -p /etc/config
+		echo "wiped merged view (no $ovl/etc)" >> $WIPE_LOG
+	fi
+	sync
+
+	{
+		echo "result:"
+		echo "/etc/config after (conffiles of the new image must show up):"
+		ls -la /etc/config 2>&1
+		echo "$ovl/etc after:"; ls -la $ovl/etc 2>&1
+		echo "/etc/board.json after:"; ls -l /etc/board.json 2>&1
+	} >> $WIPE_LOG 2>&1
+}
+
+# Called by /lib/upgrade/stage2 before it switches to the ramfs, i.e. while the
+# running system (and its /overlay) is still fully available.
+platform_pre_upgrade() {
+	[ -n "$UPGRADE_BACKUP" ] && return 0	# user asked to keep the config
+
+	platform_wipe_config
+
+	# Mirror the decision onto the console for a serial capture.
+	echo "platform_pre_upgrade: clean install (no UPGRADE_BACKUP), config wiped" \
+		> /dev/kmsg 2>/dev/null
+
+	return 0
+}
+
+platform_check_image() {
+	local board=$(board_name)
+
+	case "$board" in
+	econet,vgp-42x6v1)
+		return 0
+		;;
+	esac
+
+	return 1
+}
+
+platform_do_upgrade() {
+	local board=$(board_name)
+
+	case "$board" in
+	econet,vgp-42x6v1)
+		# Parent partition holding the FIT; mtdsplit_fit re-derives
+		# kernel/rootfs/rootfs_data from it after the next boot.
+		PART_NAME="tclinux_slave"
+		;;
+	*)
+		return 1
+		;;
+	esac
+
+	# The config reset happens in platform_pre_upgrade(), see the header.
+	default_do_upgrade "$1"
+}
diff --git a/target/linux/airoha/dts/en7523-vgp42x6v1-pon.dtsi b/target/linux/airoha/dts/en7523-vgp42x6v1-pon.dtsi
new file mode 100644
index 0000000000..8835ff94af
--- /dev/null
+++ b/target/linux/airoha/dts/en7523-vgp42x6v1-pon.dtsi
@@ -0,0 +1,325 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * vGP-42X6V1 -- PON overlay (route A), included at the END of en7523-vgp42x6v1.dts:
+ *
+ *     #include "en7523-vgp42x6v1-pon.dtsi"
+ *
+ * Must be included last: the `&eth { gdm2 ... }` block below needs the `eth`
+ * label that only the board DTS defines (the OpenWrt en7523.dtsi has no eth node).
+ *
+ * Everything below is justified by what the drivers actually read -- not by
+ * copying the community tree (whose nodes reference labels that do not exist
+ * in this tree):
+ *
+ *   airoha_xpon_probe()          drivers/net/ethernet/airoha/airoha_xpon.c:4233
+ *     - data = device_get_match_data()     -> compatible "airoha,en7523-xpon"
+ *     - syscon_regmap_lookup_by_phandle("airoha,scu")  MANDATORY
+ *     - devm_reset_control_get_optional_exclusive("mac")  (optional)
+ *     - devm_phy_get("xpon")               MANDATORY (phys/phy-names)
+ *     - of_parse_phandle("ethernet")      optional; present means no auto-probe
+ *     - platform_get_resource_byname("mac") + resource_size >= V1_XPON_REGION_SIZE
+ *       = 0x10000 (airoha_xpon.h:21)      -> reg must be 0x10000 or larger
+ *     - platform_get_irq_byname("mac"); dying-gasp is optional (:4049)
+ *     - priv->mode = AIROHA_XPON_MODE_GPON  (hardcoded; there is no
+ *       "airoha,pon-mode" property at this milestone -- do not add one)
+ *
+ *   airoha_xpon_phy_probe()      drivers/phy/airoha/phy-airoha-xpon.c:1269
+ *     - platform_get_resource(..., 0)    -> only reg[0] is mapped
+ *     - devm_reset_control_get_exclusive("phy")  MANDATORY (not optional)
+ *     - no IRQ, no pinctrl, no other property is read
+ *
+ *   airoha_setup_phylink()       drivers/net/ethernet/airoha/airoha_eth.c:5252
+ *     - of_get_phy_mode() failing means "incorrect phy-mode", so GDM2 must
+ *       declare a phy-mode.
+ *     - GDM2 declares `phy-mode = "2500base-x"` + `pcs-handle = <&pon_pcs>`
+ *       so the real PCS/PMA programs the optical SERDES (the earlier M6 value
+ *       "internal" took the no-PCS branch while CONFIG_PCS_AIROHA_EN7523 was
+ *       still off).
+ *     - no fixed-link is declared: phylink_of_phy_connect() then returns
+ *       -ENODEV, which is exactly the "no PHY or fixed-link, using xPON link
+ *       state" path (:3168) -- the AIROHA_PRIV_F_XPON_MANAGED flag is set by
+ *       airoha_eth_register_xpon().
+ *
+ *   airoha_eth_get_xpon_netdev() looks for the netdev whose port->id ==
+ *   AIROHA_GDM2_IDX (:178), so a gdm2 node is MANDATORY -- without it xpon
+ *   defers its probe forever.
+ *
+ *   GPON identity: exactly ONE property is read from the DT here --
+ *   "omci-vendor-id" (net/xpon/omci/identity.c:382). The serial comes from an
+ *   nvmem cell (see the "bob" partition in the board DTS); serial,
+ *   equipment-id and software versions have no DT property and belong to
+ *   userspace (/etc/config/omci, ubus omci.agent).
+ *
+ * reg/IRQ figures come from the vendor DT of this board family and were
+ * cross-checked against the community en7523.dtsi (xpon@1fb60000,
+ * xpon_phy@1faf0000).
+ */
+
+/* -------------------------------------------------------------------------
+ * GDM2 -- the MAC port attached to the PON block (not to GDM1's switch)
+ * ---------------------------------------------------------------------- */
+&eth {
+	gdm2: ethernet@2 {
+		compatible = "airoha,eth-mac";
+		reg = <2>;
+
+		/*
+		 * "2500base-x" selects the en7523_pcs_pon_serdes_2500basex_init()
+		 * branch added by patch 930-47 (patch 930-51 covers the
+		 * 1000Base-X rate fallback). The value was "internal" before the
+		 * PCS was enabled because airoha_setup_phylink() only takes the
+		 * no-PCS branch without pcs-handle. Modelled on
+		 * an7583.dtsi: gdm2 { pcs-handle = <&pon_pcs>; }.
+		 */
+		phy-mode = "2500base-x";
+		pcs-handle = <&pon_pcs>;
+
+		/*
+		 * Behavioural, not just a flag: airoha_eth.c reads this property
+		 * at probe to set AIROHA_PRIV_F_XPON_MANAGED *and* to strip
+		 * AIROHA_XPON_TX_OFFLOAD_FEATURES from netdev->features. The
+		 * driver's own comment is explicit: leaving generic TX offload on
+		 * "stalls GPON TX after the first few MiB".
+		 * airoha_eth_register_xpon() sets the flag too but does NOT strip
+		 * the offload, so omitting this property loses the important part.
+		 */
+		airoha,xpon-managed;
+
+		/*
+		 * PLACEHOLDER: this MAC names the PON-side netdev only (it is not
+		 * the GPON L2 address). Without any mac-address the driver falls
+		 * back to eth_hw_addr_random() -- a new MAC on every boot. Write
+		 * your own board's address here; the address this support was
+		 * developed on is redacted. Keep the first octet 02: a unicast,
+		 * locally administered placeholder cannot collide with a
+		 * vendor-assigned assignment.
+		 */
+		mac-address = [02 00 00 00 00 00];
+
+		status = "okay";
+	};
+};
+
+/*
+ * New top-level nodes must live inside `/ { ... }`: DTS does not allow nodes
+ * at the top level (only `&label { ... }` may stand alone). Missing these
+ * braces gives a dtc "syntax error" at the node name.
+ */
+/ {
+	/* -----------------------------------------------------------------
+	 * PON PHY block (EN7523 PON SERDES/PMA) -- 0x1faf0000
+	 * -------------------------------------------------------------- */
+	xpon_phy: phy@1faf0000 {
+		compatible = "airoha,en7523-xpon-phy";
+
+		/* Only reg[0] is mapped (platform_get_resource(..., 0)); 0x5000
+		 * covers every register the driver touches. */
+		reg = <0x1faf0000 0x5000>;
+
+		/*
+		 * MANDATORY (not optional): devm_gpiod_get(dev, "tx-disable",
+		 * GPIOD_OUT_HIGH) fails with -ENOENT without this property, and
+		 * then the PHY provider never registers, airoha_xpon defers
+		 * forever, /sys/class/xpon stays empty and OMCI answers -ENODEV.
+		 *
+		 * Internal pin 28 == GPIO row 16 (gpio-ranges maps row N to pin
+		 * N+12): the board's TX_DISABLE pad, and the first pad of the
+		 * driver's "pon" group (pon_pins = 28..33 after patch 202-29
+		 * removes nothing -- it removes pad 28 from the *pinctrl* group
+		 * to avoid the double-claim; see the pon_pinctrl note below).
+		 *
+		 * Polarity: the driver treats 1 as disabled and requests the line
+		 * fail-safe with GPIOD_OUT_HIGH
+		 * (gpiod_set_value_cansleep(gpio, !enable)), hence ACTIVE_HIGH.
+		 */
+		tx-disable-gpios = <&en7523_pinctrl 16 GPIO_ACTIVE_HIGH>;
+
+		/*
+		 * Routes the six PON pads to the optical block. The "pon"
+		 * function/group already exists in the pinctrl driver -- no kernel
+		 * patch needed:
+		 *   pon_pins[] = {28,29,30,31,32,33} with PINCTRL_PIN_GROUP("pon", pon),
+		 *   pon_groups[] = {"pon"} with PINCTRL_FUNC_DESC("pon", pon),
+		 *   pon_func_group -> AIROHA_FUNC_MUX, REG_GPIO_PON_MODE (SCU 0x0218).
+		 *
+		 * Why it must be declared here: the pinctrl driver clears 0x0218
+		 * (0 = GPIO) during its own probe, and the PHY driver deliberately
+		 * never sets that bit ("PON pad routing belongs to pinctrl...
+		 * cannot describe that split ownership." -- phy-airoha-xpon.c).
+		 * Without pinctrl-0 the PON pads are never routed to the optical
+		 * block.  Patch 202-29 removes pad 28 from the group so it can be
+		 * claimed as the TX-disable GPIO at the same time (measured:
+		 * "pin gpio16 already requested by 1faf0000.phy" -> -EINVAL before
+		 * the patch).
+		 */
+		pinctrl-names = "default";
+		pinctrl-0 = <&pon_pinctrl>;
+
+		/* MANDATORY: devm_reset_control_get_exclusive(dev, "phy") */
+		resets = <&scu EN7523_XPON_PHY_RST>;	/* bit 0 */
+		reset-names = "phy";
+
+		airoha,scu = <&scu_reg>;
+
+		#phy-cells = <0>;
+
+		status = "okay";
+	};
+
+	/* -----------------------------------------------------------------
+	 * PON MAC (xmac) -- 0x1fb60000; GPON at +0x4000, EPON at +0x6000
+	 * -------------------------------------------------------------- */
+	xpon: xmac@1fb60000 {
+		compatible = "airoha,en7523-xpon";
+
+		/*
+		 * resource_size("mac") must be >= 0x10000 (V1_XPON_REGION_SIZE)
+		 * -- exactly what is declared here. "tx-off" is the laser-off
+		 * register used on TX disable.
+		 */
+		reg = <0x1fb60000 0x10000>,
+		      <0x1fa2ff24 0x4>;
+		reg-names = "mac", "tx-off";
+
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,	/* mac */
+			     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;	/* dying-gasp */
+		interrupt-names = "mac", "dying-gasp";
+
+		/*
+		 * Kept as in the community reference (en7523.dtsi and the
+		 * askey_rtf8225vw board DTS): resets the MAC before a session is
+		 * started. Needs patch 202-30, which adds the .reset pulse to the
+		 * EN7523 clock/reset driver -- without it reset_control_reset()
+		 * returns -ENOTSUPP (-524) and the OMCI registration fails.
+		 */
+		resets = <&scu EN7523_XPON_MAC_RST>;	/* bit 41 */
+		reset-names = "mac";
+
+		phys = <&xpon_phy>;
+		phy-names = "xpon";
+
+		airoha,scu = <&scu_reg>;
+
+		/*
+		 * MANDATORY in practice: airoha_xpon_probe() calls
+		 * devm_optical_frontend_get_optional(dev, "pon") and then checks
+		 *     priv->sfp_bus = sfp_bus_find_fwnode(dev->fwnode);
+		 *     if (!priv->sfp_bus && !priv->frontend) {
+		 *             dev_err(dev, "missing SFP or optical frontend reference\n");
+		 *             ret = -ENODEV;   -> "error on register xPON MAC"
+		 *     }
+		 * This board has no SFP, so the probe must resolve an optical
+		 * frontend or the whole xPON stack is torn down (empty
+		 * /sys/class/xpon, OMCI answers -ENODEV). The name pair must use
+		 * the kernel-standard property names
+		 * (include/linux/optical_frontend.h), and the con_id MUST be
+		 * "pon" because that is the string the driver looks up. The
+		 * en7571 (LDDLA at 0x70 on i2c0) is the provider.
+		 */
+		optical-frontends = <&en7571>;
+		optical-frontend-names = "pon";
+
+		/* Datapath target netdev (airoha_eth_get_xpon_netdev() is the
+		 * fallback when this property is missing). */
+		ethernet = <&gdm2>;
+
+		/* ---------------------------------------------------------
+		 * GPON identity
+		 * ---------------------------------------------------------
+		 * (a) VENDOR -- the ONLY DT property the identity block reads:
+		 *     the properties[] table in net/xpon/omci/identity.c has just
+		 *     "omci-vendor-id". It has NO "omci-serial-number": the vendor
+		 *     DT of this board family declares one, but this driver never
+		 *     reads it, so do not declare it and expect it to work.
+		 *     PLACEHOLDER below: replace with the first four characters of
+		 *     your own unit's GPON serial.
+		 *
+		 * (b) SERIAL -- MANDATORY through the nvmem cell named
+		 *     "gpon-serial-number" (identity.c). Without the cell the code
+		 *     falls back to gpon_random_serial_number() and the serial
+		 *     changes on every boot (measured twice). The cell points at
+		 *     the read-only "bob" partition declared in the board DTS;
+		 *     the serial sits 0x2BC into the vendor factory block.
+		 *
+		 * Both live on the `xpon` node (and nowhere else) because
+		 * agent.c calls omci_identity_load(odev->parent, ...) -- the OMCI
+		 * device's parent IS xpon, which is where "omci-vendor-id" is
+		 * already read successfully.
+		 */
+		omci-vendor-id = "XXXX";
+		nvmem-cells = <&gpon_serial>;
+		nvmem-cell-names = "gpon-serial-number";
+
+		status = "okay";
+	};
+
+	/* -----------------------------------------------------------------
+	 * PON PCS/PMA -- 0x1fa60000
+	 * --------------------------------------------------------------
+	 * Why this node exists: `airoha_setup_phylink()` only takes the
+	 * no-PCS branch when a MAC port declares `phy-mode = "internal"` and
+	 * no pcs-handle. To let the real PCS/PMA program the optical SERDES
+	 * you need (a) CONFIG_PCS_AIROHA_EN7523 on -- proven regression-free
+	 * on hardware -- and (b) this node plus pcs-handle on gdm2.
+	 *
+	 * The five `reg-names` must match the en7523_pon_res[] array in
+	 * drivers/net/pcs/airoha/pcs-en7523.c exactly -- "pcs-mac", "pcs1",
+	 * "pcs2", "an", "rate-adapt" -- because the driver looks them up with
+	 * platform_get_resource_byname. Do NOT copy the example from the
+	 * airoha,en7523-pcs.yaml binding: it writes "pcs_mac" (underscores)
+	 * and is older than the driver. Addresses and sizes follow the PON
+	 * example in that same binding.
+	 *
+	 * No `resets` here even though the binding allows it: the driver uses
+	 * devm_reset_control_bulk_get_optional_exclusive(), so a missing reset
+	 * is silently skipped, but declaring them would fail -- the two resets
+	 * EN7523_XPON_MAC_RST / EN7523_XPON_PHY_RST are already held
+	 * *exclusive* by the `xpon` and `xpon_phy` nodes, so bulk_get would
+	 * return -EBUSY and kill the PCS probe. MAC/PHY reset stays with those
+	 * two nodes, as before.
+	 */
+	pon_pcs: pcs@1fa60000 {
+		compatible = "airoha,en7523-pcs-pon";
+
+		reg = <0x1fa60000 0x1000>,
+		      <0x1fa65100 0x4a0>,
+		      <0x1fa65a00 0x1ac>,
+		      <0x1fa65e00 0x64>,
+		      <0x1fa66000 0xdc>;
+		reg-names = "pcs-mac", "pcs1", "pcs2", "an", "rate-adapt";
+
+		/* syscon_regmap_lookup_by_phandle("airoha,scu") -- MANDATORY
+		 * (pcs-en7523.c). This is the SCU *syscon* (`&scu_reg`), not the
+		 * reset controller (`&scu`) -- same as xpon/xpon_phy. */
+		airoha,scu = <&scu_reg>;
+
+		#pcs-cells = <0>;
+
+		status = "okay";
+	};
+};
+
+/*
+ * -------------------------------------------------------------------------
+ * pinctrl state "pon" (for `pinctrl-0 = <&pon_pinctrl>` on xpon_phy)
+ * -------------------------------------------------------------------------
+ * The node must be a child of the pinctrl controller -- on the board DTS
+ * that is `en7523_pinctrl: pinctrl { ... }` inside
+ * system-controller@1fbf0200 (the label already exists; only the child is
+ * added here). The `function`/`groups` strings must match EXACTLY what the
+ * driver declares: PINCTRL_FUNC_DESC("pon", pon) and
+ * PINCTRL_PIN_GROUP("pon", pon).
+ *
+ * No `pins = "gpioN"` here: the "pon" group is a fixed six-pad group
+ * (pins 28..33, minus pad 28 after patch 202-29) defined by the driver, not
+ * a per-pad configurable group.
+ */
+&en7523_pinctrl {
+	pon_pinctrl: pon {
+		mux {
+			function = "pon";
+			groups = "pon";
+		};
+	};
+};
diff --git a/target/linux/airoha/dts/en7523-vgp42x6v1.dts b/target/linux/airoha/dts/en7523-vgp42x6v1.dts
new file mode 100644
index 0000000000..f4a9aa6968
--- /dev/null
+++ b/target/linux/airoha/dts/en7523-vgp42x6v1.dts
@@ -0,0 +1,683 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * vG/econet vGP-42X6V1 -- GPON ONU on the Airoha/Econet EN7523 SoC
+ * Board bring-up for OpenWrt.
+ *
+ * Milestones already validated on real hardware:
+ *   M2/M3: UART + NAND (FIT splits kernel/rootfs/rootfs_data) + UBI overlay on mtd7 + PCIe/WiFi
+ *   M4   : internal Ethernet -- FE/QDMA/GDMP + GDM1 + GSW (MT7530 compatible) -> 4 LAN ports
+ *
+ * Data sources:
+ *  - /proc/mtd, /proc/meminfo, /proc/cmdline (see docs/reverse-engineering.md)
+ *  - the stock device tree extracted from the vendor FIT image
+ *  - eth/gdm1/switch/gsw_port/mdio nodes: from the upstream EN7523 patch series
+ *    (OpenWrt PR #20104, patches 930-42..930-51) -- see docs/ethernet.md
+ *
+ * NOTE: the PON nodes (xpon / xpon_phy / pon_pcs / laser) are NOT here -- they need a
+ * separate config + PON patch (see openwrt/pon/README.md). M4 only enables Ethernet/switch,
+ * so the optical part is still in the "no driver yet" state.
+ */
+/dts-v1/;
+
+/* ATF is placed at the start of DRAM by the bootloader (tcboot/U-Boot), as in en7523-evb.dts */
+/memreserve/ 0x80000000 0x200000;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/reset/airoha,en7523-reset.h>
+#include "en7523.dtsi"
+
+/ {
+	model = "vG/econet vGP-42X6V1";
+	compatible = "econet,vgp-42x6v1", "airoha,en7523";
+
+	aliases {
+		serial0 = &uart1;
+		/* status LEDs for diag.sh / init.d/led (get_dt_led boot|running|...) */
+		led-boot = &led_power;
+		led-running = &led_power;
+		led-failsafe = &led_power;
+		led-upgrade = &led_power;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200n8 earlycon";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x80200000 0x1fe00000>;
+	};
+
+	/*
+	 * Real RAM = 512 MB. Read live: MemTotal 480136 kB (~32 MiB at the start is reserved
+	 * by NPU/ATF). The stock DT declares 0x40000000 (1 GiB) -- WRONG, do not use.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+
+	/*
+	 * ------------------------------------------------------------------
+	 * I2C0 (0x1fbf8000) -- the optical bus (BOSA/EN7571 at 0x70)
+	 * ------------------------------------------------------------------
+	 * On the stock firmware the DDMI values are read through the PON PHY
+	 * block's *internal* I2C master, while the community tree and the one
+	 * public EN7523 port (Zyxel PX3321-T1) both put the EN7571 on the SoC's
+	 * I2C0 at address 0x70. This is the experiment that settles it: enable
+	 * the bus and the driver, then scan for 0x70 with `i2cdetect -y -r 0`.
+	 * - airoha_caps: max_clk_div 0xfff, atomic polling, no CFG2 register
+	 *   (patch 930-52, taken from the airoha_en7523_all branch).
+	 * - fixed 20 MHz clock, 100 kHz bus. No pinctrl: the I2C pads use the
+	 *   SoC defaults.
+	 *
+	 * Address 0x70 was confirmed on real hardware (2026-10-08): an
+	 * `i2cdetect -y -r 0` scan answers at 0x70, so the EN7571 is on this bus
+	 * and the read-only probing phase is over. The child node below hands
+	 * the part to the optical frontend driver, which writes its bring-up
+	 * sequence and the board BOB calibration into the laser-diode driver.
+	 * Keep the fibre unplugged and the PON port dark while that driver is
+	 * brought up: the stock LED map calls this board's TX-disable line
+	 * GPIO16, and nothing in this DTS claims it, so the dark state rests on
+	 * the BOSA's own power-up state rather than on Linux.
+	 */
+	i2cclock: i2cclock@0 {
+		#clock-cells = <0>;
+		compatible = "fixed-clock";
+		clock-frequency = <20000000>;
+	};
+
+	i2c0: i2c0@1fbf8000 {
+		compatible = "airoha,en7523-i2c";
+		reg = <0x1fbf8000 0x100>;
+		clocks = <&i2cclock>;
+		clock-frequency = <100000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+
+		/*
+		 * BOSA + EN7571 laser-diode driver / limiting amplifier.
+		 *
+		 * firmware-name points at this unit's own BOB calibration blob
+		 * (400 B, magic 0x07050701 at byte 0x94 -- the byte lddla_bob_import()
+		 * uses to identify both the chip family and the 32-bit word
+		 * endianness of the source). The file is installed at
+		 * /lib/firmware/airoha/en7571_bob.bin.
+		 *
+		 * Deliberately no nvmem-cells: the driver tries an nvmem cell named
+		 * "calibration" first and falls back to firmware-name when there is
+		 * none. Reading the BOB straight out of flash later would mean
+		 * pointing a cell at the factory block (BOB at 0x6F00000+0x497).
+		 */
+		en7571: lddla@70 {
+			compatible = "airoha,en7571";
+			reg = <0x70>;
+			firmware-name = "airoha/en7571_bob.bin";
+
+			/*
+			 * MANDATORY for this node to act as an optical frontend
+			 * *provider*: optical/core.c devm_optical_frontend_get_optional()
+			 *     -> fwnode_property_get_reference_args(fwnode,
+			 *           "optical-frontends",
+			 *           "#optical-frontend-cells", 0, index, &args);
+			 *     if (ret) { if (ret == -ENOENT) return NULL;
+			 *                return ERR_PTR(ret); }   <- -EINVAL
+			 * Without this property the lookup returns -EINVAL (not
+			 * -EPROBE_DEFER), so airoha_xpon_probe() takes the "failed to
+			 * get optical frontend" branch -> "error on register xPON MAC"
+			 * -> the whole xPON stack is torn down.
+			 */
+			#optical-frontend-cells = <0>;
+		};
+	};
+
+	/*
+	 * ------------------------------------------------------------------
+	 * Internal Ethernet (M4)
+	 * ------------------------------------------------------------------
+	 * EN7523 has a Frame Engine (FE) + 2 QDMA blocks (PDMA/QDMA) + GDMP, and 3
+	 * internal MAC ports called GDM:
+	 *   GDM1 -> internal switch (GSW) -> 4 LAN PHY ports (phy-mode "internal")
+	 *   GDM2 -> PON MAC (SGMII 2500Base-X) -- needs a PCS node, NOT enabled in M4
+	 *   GDM3 -> USB serdes                              -- NOT enabled in M4
+	 * Driver: drivers/net/ethernet/airoha/airoha_eth.c (CONFIG_NET_AIROHA=y).
+	 * The GSW switch is MT7530 compatible -> use the mt7530 DSA driver (CONFIG_NET_DSA_MT7530_MMIO).
+	 * Addresses/IRQs/resets come from the upstream patch series (930-42..930-51), already
+	 * cross-checked against Kiwironic's working EN7523 board DT.
+	 */
+	eth: ethernet@1fb50000 {
+		compatible = "airoha,en7523-eth";
+		status = "okay";
+
+		reg = <0x1fb50000 0x2600>,
+		      <0x1fb54000 0x2000>,
+		      <0x1fb56000 0x2000>,
+		      <0x1fbf9000 0x1000>;
+		reg-names = "fe", "qdma0", "qdma1", "gdmp";
+
+		resets = <&scu EN7523_FE_RST>,
+			 <&scu EN7523_FE_PDMA_RST>,
+			 <&scu EN7523_FE_QDMA_RST>,
+			 <&scu EN7523_DUAL_HSI0_MAC_RST>,
+			 <&scu EN7523_DUAL_HSI1_MAC_RST>,
+			 <&scu EN7523_HSI_MAC_RST>,
+			 <&scu EN7523_GDMP_RST>;
+		reset-names = "fe", "pdma", "qdma",
+			      "hsi0-mac", "hsi1-mac", "hsi-mac", "gdmp";
+
+		interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
+
+		memory-region = <&qdma0_buf>, <&qdma1_buf>;
+		memory-region-names = "qdma0-buf", "qdma1-buf";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gdm1: ethernet@1 {
+			compatible = "airoha,eth-mac";
+			reg = <1>;
+			/* GDM1 only supports "internal" when connected to the internal switch */
+			phy-mode = "internal";
+			status = "okay";
+
+			nvmem-cells = <&macaddr_vendor>;
+			nvmem-cell-names = "mac-address";
+
+			fixed-link {
+				speed = <10000>;
+				full-duplex;
+				pause;
+			};
+		};
+	};
+
+	switch: switch@1fb58000 {
+		compatible = "airoha,en7523-switch";
+		reg = <0x1fb58000 0x8000>;
+		resets = <&scu EN7523_GSW_RST>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
+		status = "okay";
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gsw_port1: port@1 {
+				reg = <1>;
+				label = "lan1";
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy1>;
+				status = "okay";
+			};
+
+			gsw_port2: port@2 {
+				reg = <2>;
+				label = "lan2";
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy2>;
+				status = "okay";
+			};
+
+			gsw_port3: port@3 {
+				reg = <3>;
+				label = "lan3";
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy3>;
+				status = "okay";
+			};
+
+			gsw_port4: port@4 {
+				reg = <4>;
+				label = "lan4";
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy4>;
+				status = "okay";
+			};
+
+			/* port 6 = CPU port, connected to MAC GDM1 */
+			port@6 {
+				reg = <6>;
+				ethernet = <&gdm1>;
+				phy-mode = "internal";
+
+				fixed-link {
+					speed = <10000>;
+					full-duplex;
+					pause;
+				};
+			};
+		};
+
+		mdio: mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gsw_phy1: ethernet-phy@9 {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <9>;
+			};
+
+			gsw_phy2: ethernet-phy@a {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <10>;
+			};
+
+			gsw_phy3: ethernet-phy@b {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <11>;
+			};
+
+			gsw_phy4: ethernet-phy@c {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <12>;
+			};
+		};
+	};
+};
+
+/*
+ * QDMA DMA area. en7523.dtsi already has a reserved-memory node (5 regions for
+ * the NPU, 0x84000000-0x86E00000), so here we extend it by path overlay -- do NOT
+ * create a second reserved-memory node (dtc will report a duplicate node name).
+ *
+ * 0x87000000-0x8A000000 is inside the 512 MB DRAM, right after the dtsi NPU region.
+ * "no-map" => the kernel does not map this area; only the eth driver uses it as ring buffers.
+ */
+&{/reserved-memory} {
+	qdma0_buf: qdma0-buf@87000000 {
+		no-map;
+		reg = <0x87000000 0x02000000>;
+	};
+
+	qdma1_buf: qdma1-buf@89000000 {
+		no-map;
+		reg = <0x89000000 0x01000000>;
+	};
+};
+
+/*
+ * ------------------------------------------------------------------
+ * img16: drop the 2 old "GPIO banks", use the airoha,en7523-pinctrl driver
+ * ------------------------------------------------------------------
+ * The old banks (`airoha,en7523-gpio` declared in en7523.dtsi) map
+ * 0x1fbf0204/0200/0220/0214 + 0x1fbf0270/0260/0264/0278 -- they OVERLAP the
+ * 0x1fbf0200..0x1fbf02bf window of the pinctrl driver => the two drivers cannot
+ * coexist. The old nodes must go, exactly as in U-Boot patch
+ * 110-arm-dts-en7523-add-pinctrl-gpio-support-drop-legacy-.patch.
+ */
+/delete-node/ &gpio0;
+/delete-node/ &gpio1;
+
+/*
+ * (C1) `syscon_node_to_regmap()` only accepts a node with compatible "syscon"
+ * (drivers/mfd/syscon.c: device_node_get_regmap(np,
+ * of_device_is_compatible(np, "syscon"), true)); the `scu:` node of en7523.dtsi
+ * (`compatible = "airoha,en7523-scu"`) does NOT have it => add "syscon" here.
+ * This does not change clock driver behaviour: it matches the of_match_table
+ * entry "airoha,en7523-scu" (still first in the list), and the reg window
+ * 0x1fa20000+0x400 fully covers the IOMUX range 0x210..0x224.
+ */
+&scu {
+	compatible = "airoha,en7523-scu", "syscon";
+};
+
+/ {
+	/*
+	 * (C3) SCU register window (0x1fb00000) -- mandatory for the PON driver.
+	 *
+	 * The en7523.dtsi `scu:` node merges TWO regions:
+	 *     reg = <0x1fa20000 0x400>, <0x1fb00000 0x1000>;
+	 * but syscon only takes reg[0] (of_syscon_register -> of_address_to_resource
+	 * (np, 0)), so the regmap has max_register = 0x3fc. Consequence: every
+	 * `airoha-xpon` access to RST_CTRL2 (0x830) / RST_CTRL1 (0x834) -- which live
+	 * at 0x1fb00830/0x1fb00834 -- is SILENTLY REFUSED by regmap: writes have no
+	 * effect and reads keep returning stack garbage.
+	 *
+	 * The community tree solves it by SPLITTING into two nodes (chip_scu at
+	 * 0x1fa20000 and scuclk at 0x1fb00000) and pointing every consumer at
+	 * `airoha,scu = <&scuclk>`. Here the minimal version: one extra syscon node
+	 * for the 0x1fb00000 register window only, referenced by the two PON nodes
+	 * (see en7523-vgp42x6v1-pon.dtsi). The compatible is deliberately NOT
+	 * "airoha,en7523-scu" so the clock/reset driver does not probe twice.
+	 */
+	scu_reg: syscon@1fb00000 {
+		compatible = "airoha,en7523-scu-regs", "syscon";
+		reg = <0x1fb00000 0x1000>;
+	};
+
+	system-controller@1fbf0200 {
+		compatible = "syscon", "simple-mfd";
+		/* >= 0x98 (irq_edge/level up to 0x94) and covers LAN_LED1_MAPPING 0x7c.
+		 * The vendor DT declares 0x80, which is TOO SMALL. */
+		reg = <0x1fbf0200 0xc0>;
+
+		en7523_pinctrl: pinctrl {
+			compatible = "airoha,en7523-pinctrl";
+
+			/*
+			 * (C2) MANDATORY. Without this phandle
+			 * syscon_regmap_lookup_by_compatible("airoha,en7523-chip-scu") returns NULL
+			 * (no DTS in the tree declares that compatible) => -ENODEV => probe bails out:
+			 * NO gpiochip, and every LED + button is lost. (U-Boot looks up the SCU a
+			 * different way, so the blueprint copied from the U-Boot patch misses this
+			 * line.)
+			 */
+			airoha,chip-scu = <&scu>;
+
+			/* platform_get_irq() runs BEFORE devm_gpiochip_add_data() =>
+			 * without these two lines the gpiochip is lost. GIC_SPI 26 is correct for the
+			 * whole EN7523/AN7581/AN7583 family. */
+			interrupt-parent = <&gic>;
+			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			/* MANDATORY in practice:
+			 * airoha_convert_pin_to_reg_offset() uses
+			 * pinctrl_find_gpio_range_from_pin_nolock(); without a range => -EINVAL for
+			 * every set/get operation.
+			 * Row N <-> internal pin N+12 => <&en7523_pinctrl N> ==
+			 * <&en7523_pinctrl N>; the number 12 is NOT a row shift. */
+			gpio-ranges = <&en7523_pinctrl 0 12 30>;
+
+			/*
+			 * No pinctrl-0 is needed to "return the pads to GPIO": patch 203-02
+			 * writes 0 to 5 SCU IOMUX registers right in probe --
+			 * 0x0210 2ND_I2C_MODE, 0x0214 SPI_CS1_MODE, 0x0218 PON_MODE,
+			 * 0x0220 NPU_UART_EN, 0x0224 FORCE_GPIO_EN (EN7523: 0 = GPIO)
+			 * -- BEFORE the gpiochip is registered. Those are exactly the bits
+			 * holding gpio1/3/11/26.
+			 * WARNING: for gpio0..27 there is NO `function = "gpio"`: gpio_groups[]
+			 * only declares gpio28/gpio29. Never use `"pwm"` to
+			 * "return to GPIO" -- it SETS the PWM bit.
+			 * WARNING: REG_GPIO_FLASH_MODE_CFG 0x1fbf0234 / _EXT 0x1fbf0268
+			 * are NOT cleared; if a pad is still dead, read those two registers.
+			 */
+		};
+	};
+};
+
+/*
+ * ------------------------------------------------------------------
+ * Front-panel LEDs + buttons (M4.5) -- GPIO numbers MEASURED on real hardware
+ * ------------------------------------------------------------------
+ * The vendor table `userfs/7523duled.conf` does NOT match this board (see docs section
+ * 25.19.11-25.19.13): many pads the vendor marks as LEDs have no LED on this unit, so
+ * the numbers below are MEASURED RESULTS, not derived from the vendor table.
+ *
+ * Measurement method: drive each pad low while all other pads are high, then read
+ * back the `data[]` register (0x1fbf0204) to be sure the pad really changed level.
+ *
+ *   pad 27 -> PWR (blue)   OK: lit right after boot because bit27 of `data[]`
+ *                              defaults to 0 -- this is NOT any driver, so
+ *                              `default-state = "on"` is required to keep it.
+ *   pad 1  -> INT (case prints INET, blue) OK
+ *   pad 10 -> PON (green)     OK
+ *   pad 6  -> LOS (case prints ALM)  OK  (img15/img16 used pad 6 = WLAN 2.4G: WRONG)
+ *   pad 11 -> NO LED (vendor table says PWR) -- this is the root cause of the
+ *            "POWER cannot be controlled" bug in img15/img16: the DTS drove
+ *            pad 11 while pad 11 is dead.
+ *   pad 3, 26 -> NO LED (vendor table says LOS, WPS)
+ *   pad 2,4,5,8,9,12..21,28,29 -> NO LED
+ *   pad 22..25 -> switch LED pads: muxed to the switch LED engine, so driving
+ *            them as GPIO has no effect (the 4 LAN1-4 LEDs still work normally)
+ *
+ * WARNING: gpio29 = `pcie_reset1` (the vendor table calls it the Internet LED): pulling
+ *   it low resets PCIe => WiFi is lost. Do NOT declare an LED for it, do not test it.
+ *
+ * LAN1-4: driven by the switch LED engine (SCU 0x1fa20210 bits 3/5/7/9 =
+ *   LAN0..3_LED0_MODE = 1) => not declared in the DTS and not controllable via
+ *   GPIO.
+ * 2.4G / 5G: driven by the WiFi module -- `/sys/class/leds/mt76-phy0` and
+ *   `mt76-phy1` already exist; they are not SoC GPIOs.
+ * WPS: no controllable pad was found (all 28 safe pads were tried, plus holding
+ *   the button) => no LED node is declared. The WPS button on gpio7 still works.
+ *
+ * #gpio-cells = <2> => the polarity GPIO_ACTIVE_LOW is always given.
+ * &en7523_pinctrl N == &gpio0 N (internal pin = N + 12).
+ */
+/ {
+	leds {
+		compatible = "gpio-leds";
+
+		led_power: led-power {
+			function = LED_FUNCTION_POWER;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&en7523_pinctrl 27 GPIO_ACTIVE_LOW>;
+			default-state = "on";	/* bit27 defaults to 0 => "on" is required to keep PWR lit as in stock */
+		};
+
+		led_pon: led-pon {
+			function = "pon";
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&en7523_pinctrl 10 GPIO_ACTIVE_LOW>;	/* measured on real hardware */
+		};
+
+		led_los: led-los {
+			function = "los";
+			color = <LED_COLOR_ID_RED>;
+			gpios = <&en7523_pinctrl 6 GPIO_ACTIVE_LOW>;	/* measured on real hardware: pad 6 = LOS/ALM */
+		};
+
+		led_inet: led-inet {
+			function = "inet";
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&en7523_pinctrl 1 GPIO_ACTIVE_LOW>;	/* measured on real hardware: pad 1 = INET */
+		};
+	};
+
+	/*
+	 * img16: the `airoha,en7523-pinctrl` node DOES have interrupt-controller (GIC SPI 26),
+	 * so it now qualifies for switching to `gpio-keys` with real interrupts. This load
+	 * still keeps `gpio-keys-polled` so that only ONE variable (pinctrl) changes -- the
+	 * 100 ms poll runs fine; switching would need `interrupts` on every child node and
+	 * a re-check of the binding first.
+	 */
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		key-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&en7523_pinctrl 0 GPIO_ACTIVE_LOW>;	/* proven: log shows pressed/released + reboot */
+		};
+
+		key-wps {
+			label = "wps";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&en7523_pinctrl 7 GPIO_ACTIVE_LOW>;	/* dead pad before img16: holding it for 30 s did nothing */
+		};
+	};
+};
+
+/* WiFi MediaTek MT7916 sits on PCIe (kmod-mt7915e + kmod-mt7916-firmware) */
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+
+	pcie@1,0 {
+		reg = <0x0800 0 0 0 0>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		device_type = "pci";
+		ranges;
+
+		wifi@0,0 {
+			compatible = "mediatek,mt76";
+			reg = <0x0000 0 0 0 0>;
+			nvmem-cells = <&eeprom_mt7916>;
+			nvmem-cell-names = "eeprom";
+		};
+	};
+};
