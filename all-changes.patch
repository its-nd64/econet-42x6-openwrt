diff --git a/target/linux/airoha/patches-6.18/100-ARM-airoha-set-TEXT_OFFSET-2MiB.patch b/target/linux/airoha/patches-6.18/100-ARM-airoha-set-TEXT_OFFSET-2MiB.patch
new file mode 100644
index 0000000000..4e8933deaa
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/100-ARM-airoha-set-TEXT_OFFSET-2MiB.patch
@@ -0,0 +1,35 @@
+Airoha EN7523/AN7581/AN7583: ATF+TCBoot chiem 2 MiB dau DRAM (0x80000000-0x80200000).
+
+FIT duoc nap o 0x80208000 (loadaddr-$(CONFIG_TARGET_airoha_en7523) trong
+target/linux/airoha/image/Makefile).
+
+TEXT_OFFSET mac dinh cua ARM32 la 0x00008000 lam kernel link o 0xC0008000, nen
+head.S tinh  PHYS_OFFSET = runtime(_text) - TEXT_OFFSET = 0x80208000 - 0x8000
+= 0x80200000.  Gia tri do KHONG chia het cho 2 MiB nen arch/arm/kernel/phys2virt.S
+deadloop NGAY trong head.S, truoc ca parse_early_param() -> UART im lang tuyet doi.
+
+    subs  r3, r8, #PAGE_OFFSET      @ r8 = runtime(_text) - TEXT_OFFSET
+    mov   r0, r3, lsr #21
+    teq   r3, r0, lsl #21           @ must be 2 MiB aligned
+    bne   0f
+0:  mov   r0, r0                    @ deadloop on error
+    b     0b
+
+head.S con co  #error KERNEL_RAM_VADDR must start at 0xXXXX8000
+=> TEXT_OFFSET bat buoc phai ket thuc bang 0x8000.
+
+Dat TEXT_OFFSET = 0x00208000:
+  _text vat ly = PHYS_OFFSET + TEXT_OFFSET = 0x80000000 + 0x208000 = 0x80208000
+  = dung bang loadaddr cua FIT; PHYS_OFFSET = 0x80000000 (chia het 2 MiB) -> OK.
+
+CANH BAO: 0x00200000 la gia tri SAI, da tung lam kernel im lang hoan toan.
+--- a/arch/arm/Makefile
++++ b/arch/arm/Makefile
+@@ -169,6 +169,7 @@
+ textofs-$(CONFIG_ARCH_QCOM_RESERVE_SMEM) := 0x00208000
+ textofs-$(CONFIG_ARCH_MESON) := 0x00208000
+ textofs-$(CONFIG_ARCH_AXXIA) := 0x00308000
++textofs-$(CONFIG_ARCH_AIROHA) := 0x00208000
+ 
+ # Machine directory name.  This list is sorted alphanumerically
+ # by CONFIG_* macro name.
diff --git a/target/linux/airoha/patches-6.18/110-PCI-quirk-airoha-EN7523-root-complex.patch b/target/linux/airoha/patches-6.18/110-PCI-quirk-airoha-EN7523-root-complex.patch
new file mode 100644
index 0000000000..8da27322f0
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/110-PCI-quirk-airoha-EN7523-root-complex.patch
@@ -0,0 +1,46 @@
+--- a/drivers/pci/quirks.c
++++ b/drivers/pci/quirks.c
+@@ -6382,3 +6382,43 @@
+ DECLARE_PCI_FIXUP_FINAL(PCI_VENDOR_ID_GLI, 0x9750, pci_mask_replay_timer_timeout);
+ DECLARE_PCI_FIXUP_FINAL(PCI_VENDOR_ID_GLI, 0x9755, pci_mask_replay_timer_timeout);
+ #endif
++
++/*
++ * Airoha EN7523 / Econet 42X6 PCIe root complex
++ *
++ * The RC reports a bogus BAR 0: it reads 0x0000000c (64-bit prefetchable) and
++ * size-probes as 4 GiB.  pci_enable_resources() therefore fails with -EINVAL
++ * on both root ports, which leaves their PCI_COMMAND Memory Space Enable and
++ * Bus Master Enable bits clear.
++ *
++ * With bus mastering disabled on the root port, memory requests issued by an
++ * endpoint behind it (here a MediaTek MT7916) are never forwarded upstream to
++ * DRAM.  The endpoint WFDMA happily accepts the ring configuration, sets
++ * TX_DMA_EN/RX_DMA_EN and asserts TX_DMA_BUSY, but never fetches a single
++ * descriptor: cpu_idx advances while dma_idx stays 0.  Every MCU command then
++ * times out ("Message 00000010 (seq 1) timeout") and the device is unusable.
++ *
++ * Drop the bogus BARs so resource claiming succeeds, and enable memory
++ * decoding plus bus mastering explicitly.
++ */
++static void quirk_airoha_en7523_rc(struct pci_dev *dev)
++{
++	u16 cmd;
++	int i;
++
++	/* Only devices sitting directly on a root bus, i.e. the RC itself. */
++	if (dev->bus->self)
++		return;
++
++	for (i = 0; i < 2; i++) {
++		dev->resource[i].flags = 0;
++		dev->resource[i].start = 0;
++		dev->resource[i].end = 0;
++	}
++
++	pci_read_config_word(dev, PCI_COMMAND, &cmd);
++	cmd |= PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER;
++	pci_write_config_word(dev, PCI_COMMAND, cmd);
++}
++DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_MEDIATEK, 0x0810, quirk_airoha_en7523_rc);
++DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_MEDIATEK, 0x0811, quirk_airoha_en7523_rc);
diff --git a/target/linux/airoha/patches-6.18/202-29-pinctrl-airoha-exclude-TX-disable-pad-from-EN7523-pon-group.patch b/target/linux/airoha/patches-6.18/202-29-pinctrl-airoha-exclude-TX-disable-pad-from-EN7523-pon-group.patch
new file mode 100644
index 0000000000..58b3da5c67
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/202-29-pinctrl-airoha-exclude-TX-disable-pad-from-EN7523-pon-group.patch
@@ -0,0 +1,46 @@
+From: econet-42x6 port <local>
+Subject: [PATCH] pinctrl: airoha: exclude the TX_DISABLE pad from the EN7523 "pon" group
+
+The EN7523 "pon" pin group as introduced together with the SoC support
+lists pins 28..33, i.e. GPIO16..GPIO21.  Pin 28 is GPIO16, which on the
+EcoNet vGP-42X6V1 (and on the EN751221 reference design) is the
+board-level TX_DISABLE line of the optical frontend and is therefore
+consumed as a *GPIO* by the xPON PHY driver:
+
+    priv->tx_disable_gpio =
+        devm_gpiod_get(dev, "tx-disable", GPIOD_OUT_HIGH);   /* not optional */
+
+Applying the "pon" mux state claims every pin of the group through
+pin_request(), so the GPIO request for that very same pad is refused:
+
+    pinctrl-airoha-en7523 ...: pin gpio16 already requested by 1faf0000.phy;
+                               cannot claim for 1fbf0200.system-controller:pinctrl:528
+    pinctrl-airoha-en7523 ...: error -EINVAL: pin-28 (...:pinctrl:528)
+    airoha-xpon-phy 1faf0000.phy: error -EINVAL: failed to get TX disable GPIO
+    airoha-xpon-phy 1faf0000.phy: probe with driver airoha-xpon-phy failed with error -22
+
+which leaves the whole xPON stack unprobed (/sys/class/xpon empty, OMCI
+commands returning -ENODEV).
+
+Drop pin 28 from the group so that the PON-owned pads are muxed while
+GPIO16 keeps its split ownership, exactly as described in
+phy-airoha-xpon.c:
+
+    "PON pad routing belongs to pinctrl.  In particular GPIO16 is the
+     board-level TX_DISABLE line on the EN751221 reference design while
+     GPIO17..20 remain owned by the PON hardware."
+
+This mirrors the downstream fix (930-264: pon_pins { 16..20 } -> { 29..33 }).
+The PON_MODE register bit written by airoha_pinmux_set_mux() is unchanged.
+
+--- a/drivers/pinctrl/airoha/pinctrl-en7523.c
++++ b/drivers/pinctrl/airoha/pinctrl-en7523.c
+@@ -330,7 +330,7 @@
+ 	PINCTRL_PIN(41, "pcie_reset1"),
+ };
+ 
+-static const int pon_pins[] = { 28, 29, 30, 31, 32, 33 };
++static const int pon_pins[] = { 29, 30, 31, 32, 33 };
+ static const int pon_tod_1pps_pins[] = { 21 };
+ static const int gsw_tod_1pps_pins[] = { 21 };
+ static const int sipo_pins[] = { 13, 38 };
diff --git a/target/linux/airoha/patches-6.18/202-30-clk-en7523-add-reset-pulse-operation.patch b/target/linux/airoha/patches-6.18/202-30-clk-en7523-add-reset-pulse-operation.patch
new file mode 100644
index 0000000000..91c5b62cf1
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/202-30-clk-en7523-add-reset-pulse-operation.patch
@@ -0,0 +1,66 @@
+From: econet-42x6 port <local>
+Subject: [PATCH] clk: en7523: add reset pulse operation
+
+Port of the downstream patch 930-117 (Sirherobrine23).  airoha_xpon_probe()
+calls reset_control_reset() on its "mac" reset line (airoha_xpon.c:428,
+priv->mac_reset from devm_reset_control_get_optional_exclusive(dev, "mac")):
+
+    ret = reset_control_reset(priv->mac_reset);
+    if (ret) { dev_err(dev, "failed to reset xPON MAC: %d\n", ret); return ret; }
+
+reset_control_reset() returns -ENOTSUPP when the provider has no ->reset()
+callback (drivers/reset/core.c:366) and the EN7523 SCU reset controller only
+implemented assert/deassert/status, so every xPON probe failed with:
+
+    airoha-xpon 1fb60000.xmac: resetting GPON MAC before session start
+    airoha-xpon 1fb60000.xmac: failed to reset xPON MAC: -524   (-ENOTSUPP)
+    airoha-xpon 1fb60000.xmac: error -ENOTSUPP: error on register OMCI
+    airoha-xpon 1fb60000.xmac: probe with driver airoha-xpon failed with error -524
+
+Add the atomic assert/delay/deassert pulse, using the same long-pulse id list
+as the downstream patch (RST_NR_PER_BANK + {0,4,17}); every other reset,
+including EN7523_XPON_MAC_RST (=41), gets the short 10-50us pulse.
+The deterministic 'val' initialisation from the downstream patch is already
+present in this kernel (u32 val = 0), so that hunk is intentionally dropped.
+---
+--- a/drivers/clk/clk-en7523.c
++++ b/drivers/clk/clk-en7523.c
+@@ -1055,6 +1055,30 @@
+ 	return en7523_reset_update(rcdev, id, false);
+ }
+ 
++static bool en7523_reset_needs_long_pulse(unsigned long id)
++{
++	return id == RST_NR_PER_BANK + 0 ||
++	       id == RST_NR_PER_BANK + 4 ||
++	       id == RST_NR_PER_BANK + 17;
++}
++
++static int en7523_reset_reset(struct reset_controller_dev *rcdev,
++			      unsigned long id)
++{
++	int err;
++
++	err = en7523_reset_assert(rcdev, id);
++	if (err)
++		return err;
++
++	if (en7523_reset_needs_long_pulse(id))
++		usleep_range(5000, 6000);
++	else
++		usleep_range(10, 50);
++
++	return en7523_reset_deassert(rcdev, id);
++}
++
+ static int en7523_reset_status(struct reset_controller_dev *rcdev,
+ 			       unsigned long id)
+ {
+@@ -1086,6 +1110,7 @@
+ static const struct reset_control_ops en7581_reset_ops = {
+ 	.assert = en7523_reset_assert,
+ 	.deassert = en7523_reset_deassert,
++	.reset = en7523_reset_reset,
+ 	.status = en7523_reset_status,
+ };
+ 
diff --git a/target/linux/airoha/patches-6.18/610-42x6-clk-en7523-fix-uninitialized-val-in-reset-update.patch b/target/linux/airoha/patches-6.18/610-42x6-clk-en7523-fix-uninitialized-val-in-reset-update.patch
new file mode 100644
index 0000000000..eea4f7fedf
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/610-42x6-clk-en7523-fix-uninitialized-val-in-reset-update.patch
@@ -0,0 +1,45 @@
+clk: en7523: fix uninitialized `val` in en7523_reset_update()
+
+Patch 609-02-clk-en7523-add-support-for-dedicated-PCIe-PERSTOUT-reset.patch
+thay bieu thuc dung bang mot bien `val` KHONG duoc khoi tao, roi lai dung `|=`:
+
+    u32 addr = rst_data->bank_ofs[id / RST_NR_PER_BANK];
+    u32 val;                                  /* <-- khong khoi tao */
+    /* For PCIC reset logic is inverted, 0:assert 1:deassert*/
+    if (addr == REG_NP_SCU_PCIC)
+        val |= assert ? 0 : BIT(id % RST_NR_PER_BANK);
+    else
+        val |= assert ? BIT(id % RST_NR_PER_BANK) : 0;
+    regmap_update_bits(rst_data->map, addr, BIT(id % RST_NR_PER_BANK), val);
+
+Truoc 609-02 ham nay dung (khong co bien trung gian):
+
+    regmap_update_bits(rst_data->map, addr, BIT(id % RST_NR_PER_BANK),
+                       assert ? BIT(id % RST_NR_PER_BANK) : 0);
+
+Vi mask chi co MOT bit, gia tri ghi vao thanh ghi chinh la bit do. Vay:
+  - nhanh assert  : val |= BIT(...)  -> bit luon = 1  (dung)
+  - nhanh deassert: val |= 0         -> bit = BIT RAC tren stack  (SAI)
+
+Hau qua tren EN7523 (vgP-42X6V1): reset_control_bulk_deassert() van tra ve 0
+(khong bao loi), nhung bit 21 cua SCU RST_CTRL1 (0x1fb00834) - chan FE - co the
+van = 1, tuc FE bi GIU trong trang thai reset. Lan doc MMIO dau tien vao FE
+(0x1fb50500, REG_GDM_FWD_CFG(1)) khi do treo CPU vinh vien: AXI slave khong phan
+hoi va khong co bus timeout. Quan sat: kernel dung ngay sau marker
+AIROHA-TRACE maccr-01-portloop, tuc ben trong vong lap dau tien cua
+airoha_fe_maccr_init().
+
+Sua: khoi tao `u32 val = 0;`. Vi mask chi 1 bit, gia tri 0 khoi phuc dung ngu
+nghia truoc 609-02:
+  - non-PCIC: assert -> 1, deassert -> 0
+  - PCIC    : dao nguoc (assert -> 0, deassert -> 1) nhu chu thich
+
+Bug nay anh huong MOI reset line non-PCIC (FE/PDMA/QDMA/XSI MAC/GSW/...), khong
+chi rieng ethernet.
+--- a/drivers/clk/clk-en7523.c
++++ b/drivers/clk/clk-en7523.c
+@@ -1030,3 +1030,3 @@
+ 	struct en_rst_data *rst_data = container_of(rcdev, struct en_rst_data, rcdev);
+ 	u32 addr = rst_data->bank_ofs[id / RST_NR_PER_BANK];
+-	u32 val;
++	u32 val = 0;
diff --git a/target/linux/airoha/patches-6.18/930-42-airoha_en7523_all-airoha_en7523_eth-allocate-GDM-ports-before-QDMA-hw-.patch b/target/linux/airoha/patches-6.18/930-42-airoha_en7523_all-airoha_en7523_eth-allocate-GDM-ports-before-QDMA-hw-.patch
new file mode 100644
index 0000000000..94fde05389
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-42-airoha_en7523_all-airoha_en7523_eth-allocate-GDM-ports-before-QDMA-hw-.patch
@@ -0,0 +1,92 @@
+From a606c062960289b8f2ea9e807fb39c4010e24325 Mon Sep 17 00:00:00 2001
+From: Benjamin Larsson <noreply@localhost>
+Date: Thu, 11 Jun 2026 02:20:00 +0000
+Subject: [PATCH 042/131] airoha_en7523_eth: allocate GDM ports before QDMA hw
+ init
+
+airoha_probe() brought up the QDMA hardware (airoha_hw_init() +
+airoha_qdma_start_napi()) before allocating the GDM ports. The GDM port
+allocation reads the port MAC address via of_get_ethdev_address(), which
+on boards that store the MAC in a late-registering nvmem provider (e.g. a
+U-Boot env or fixed-layout cell on a UBI volume) returns -EPROBE_DEFER.
+
+On that defer the probe error path runs airoha_hw_cleanup() ->
+page_pool_destroy() while the RX DMA is already live. page_pool_destroy()
+then busy-waits for in-flight RX pages that are never returned, live-locks
+against the RX softirq and hangs the CPU - so the deferred probe is never
+retried and the board never boots.
+
+Allocate the GDM ports (and thus read the MAC) before airoha_hw_init() so
+an -EPROBE_DEFER unwinds before any RX ring or page pool exists. Add an
+error_ports_free label for the pre-hardware unwind; the post-hardware
+failure path keeps stopping NAPI and calling airoha_hw_cleanup().
+
+Signed-off-by: Benjamin Larsson <noreply@localhost>
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/ethernet/airoha/airoha_eth.c | 30 +++++++++++++++---------
+ 1 file changed, 19 insertions(+), 11 deletions(-)
+
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -4084,13 +4084,15 @@ static int airoha_probe(struct platform_
+ 	strscpy(eth->napi_dev->name, "qdma_eth", sizeof(eth->napi_dev->name));
+ 	platform_set_drvdata(pdev, eth);
+ 
+-	err = airoha_hw_init(pdev, eth);
+-	if (err)
+-		goto error_netdev_free;
+-
+-	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+-		airoha_qdma_start_napi(&eth->qdma[i]);
+-
++	/* Allocate the GDM ports before bringing up the QDMA hardware. This
++	 * reads the port MAC address, which may be supplied by a late nvmem
++	 * provider (e.g. a U-Boot env or fixed-layout cell on a UBI volume)
++	 * and can therefore return -EPROBE_DEFER. Doing it before
++	 * airoha_hw_init() guarantees such a defer unwinds before any RX ring
++	 * or page pool exists; otherwise the error path would call
++	 * page_pool_destroy() while RX DMA is still running, which live-locks
++	 * against the RX softirq and hangs the CPU before the probe is retried.
++	 */
+ 	for_each_child_of_node(pdev->dev.of_node, np) {
+ 		if (!of_device_is_compatible(np, "airoha,eth-mac"))
+ 			continue;
+@@ -4101,10 +4103,17 @@ static int airoha_probe(struct platform_
+ 		err = airoha_alloc_gdm_port(eth, np);
+ 		if (err) {
+ 			of_node_put(np);
+-			goto error_napi_stop;
++			goto error_ports_free;
+ 		}
+ 	}
+ 
++	err = airoha_hw_init(pdev, eth);
++	if (err)
++		goto error_ports_free;
++
++	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
++		airoha_qdma_start_napi(&eth->qdma[i]);
++
+ 	err = airoha_register_gdm_devices(eth);
+ 	if (err)
+ 		goto error_napi_stop;
+@@ -4114,7 +4123,8 @@ static int airoha_probe(struct platform_
+ error_napi_stop:
+ 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+ 		airoha_qdma_stop_napi(&eth->qdma[i]);
+-
++	airoha_hw_cleanup(eth);
++error_ports_free:
+ 	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+ 		struct airoha_gdm_port *port = eth->ports[i];
+ 		int j;
+@@ -4138,8 +4148,6 @@ error_napi_stop:
+ 		}
+ 		airoha_metadata_dst_free(port);
+ 	}
+-	airoha_hw_cleanup(eth);
+-error_netdev_free:
+ 	free_netdev(eth->napi_dev);
+ 	platform_set_drvdata(pdev, NULL);
+ 
