diff -u -r a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
--- a/drivers/net/ethernet/airoha/airoha_xpon.c	2026-10-12 07:26:21.984073585 +0000
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c	2026-10-12 07:26:22.077523777 +0000
@@ -51,6 +51,19 @@
 #include "airoha_regs.h"
 #include "airoha_ploam.h"
 
+/*
+ * M7-m: on EN7523 the OMCI branch that runs once the PON reaches O2
+ * stalls the bus with no timeout, so keep the MAC out of O2 until that
+ * path is fixed. Default 1 (SAFE): every boot completes normally, even
+ * after a hung experiment needed a power cycle. Flip it at runtime with
+ *   echo 0 > /sys/module/airoha_xpon/parameters/xpon_stop_before_ploam
+ *   rmmod airoha_xpon && modprobe airoha_xpon
+ */
+static bool xpon_stop_before_ploam = true;
+module_param(xpon_stop_before_ploam, bool, 0644);
+MODULE_PARM_DESC(xpon_stop_before_ploam,
+		 "stop GPON bring-up before ploam_start (default 1, safe)");
+
 /* Linux 6.18 replaced from_timer() with timer_container_of().
  * Keep the driver buildable on older kernel trees as well.
  */
@@ -2528,6 +2541,15 @@
 	WRITE_ONCE(priv->mac_enabled, true);
 
 	/*
+	 * M7-m: keep the FSM out of O2. The OMCI path that runs afterwards
+	 * is the suspected bus-stall site; see the module parameter above.
+	 */
+	if (xpon_stop_before_ploam) {
+		dev_info(priv->dev,
+			 "M7-m: STOPPING before ploam_start (xpon_stop_before_ploam=1)\n");
+		return 0;
+	}
+	/*
 	 * The external TX interlock has already been released by the PHY
 	 * power-on path.  GPON stays optically quiet in O2 because BEN is
 	 * generated by the xPON hardware only for valid upstream grants.
