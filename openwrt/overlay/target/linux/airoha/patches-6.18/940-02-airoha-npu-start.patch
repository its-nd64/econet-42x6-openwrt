diff -ruN a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
--- a/drivers/net/ethernet/airoha/airoha_npu.c	2026-10-10 18:11:38.146413226 +0000
+++ b/drivers/net/ethernet/airoha/airoha_npu.c	2026-10-10 18:11:38.215891956 +0000
@@ -864,3 +864,30 @@
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("Lorenzo Bianconi <lorenzo@kernel.org>");
 MODULE_DESCRIPTION("Airoha Network Processor Unit driver");
+
+/*
+ * 42X6 / route A: the community baseline 781502ce (04-08) calls
+ * airoha_npu_start() from airoha_eth.c after all GDM netdevs are registered,
+ * to release the NPU firmware later (avoids an NPU fault when the Ethernet
+ * probe fails).
+ *
+ * Current upstream 6.18 has no such API: the NPU firmware is loaded inside
+ * airoha_npu_probe() and referenced via airoha_npu_get()/airoha_npu_put()
+ * from airoha_eth_probe(). The shim below keeps the caller-side semantics
+ * (return 0 when the NPU is ready, -ENODEV when there is no "airoha,npu"
+ * phandle) but does nothing extra: the 04-08 split of "load firmware" from
+ * "Ethernet probe" is a behaviour change that has not been ported (see the
+ * route-A port notes).
+ */
+int airoha_npu_start(struct device *dev)
+{
+	struct airoha_npu *npu = airoha_npu_get(dev);
+
+	if (IS_ERR(npu))
+		return PTR_ERR(npu);
+
+	airoha_npu_put(npu);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_npu_start);
