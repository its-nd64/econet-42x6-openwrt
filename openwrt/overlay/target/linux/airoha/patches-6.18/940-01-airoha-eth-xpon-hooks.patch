+
+		err = airoha_qdma_set_trtcm_config(qdma, channel,
+						   REG_EGRESS_TRTCM_CFG, mode,
+						   enable, TRTCM_METER_MODE);
+		if (err)
+			return err;
+		if (!enable)
+			continue;
+
+		err = airoha_qdma_set_trtcm_token_bucket(qdma, channel,
+							 REG_EGRESS_TRTCM_CFG,
+							 mode, rate, bucket_size);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
